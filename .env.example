# --- API ---------------------------------------------------------------------
NODE_ENV=development
PORT=3333
LOG_LEVEL=info
# Origens liberadas no CORS, separadas por vírgula ("*" libera todas)
CORS_ORIGINS=*
# Gere com: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_EXPIRES_IN=1d
STORAGE_DIR=./storage
MAX_UPLOAD_MB=100

# --- Infra -------------------------------------------------------------------
POSTGRES_URL=postgres://torque:torque@localhost:5432/torquespec
REDIS_URL=redis://localhost:6379

# --- LLM (geração das respostas) --------------------------------------------
# gemini | openai (qualquer API compatível com /chat/completions) | fake (offline, sem custo)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
# Só para LLM_PROVIDER=openai. Ex.: https://api.openai.com/v1, https://api.groq.com/openai/v1, http://localhost:11434/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.1

# --- Embeddings (768 dimensões) ---------------------------------------------
# ollama (nomic-embed-text, local) | gemini (gemini-embedding-001) | fake
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_URL=http://localhost:11434
# Para EMBEDDING_PROVIDER=gemini; se vazio, usa LLM_API_KEY
EMBEDDING_API_KEY=

# --- RAG ---------------------------------------------------------------------
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RAG_TOP_K=6
RAG_CANDIDATES=30
ASK_RATE_LIMIT_PER_MINUTE=20

# --- Seed --------------------------------------------------------------------
ADMIN_EMAIL=admin@torquespec.dev
ADMIN_PASSWORD=torquespec-admin

# --- Testes de integração (banco descartável: o schema é recriado a cada execução)
TEST_POSTGRES_URL=postgres://torque:torque@localhost:5432/torquespec_test
